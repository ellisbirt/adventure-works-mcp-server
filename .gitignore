# .gitignore
# .NET Build artifacts
bin/
obj/
*.suo
*.user

# Node / Frontend dependencies
node_modules/
dist/
npm-debug.log

# Terraform local state variables and locks
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
*.tfvars
*.tfvars.json
!terraform.tfvars.example
!*.tfvars.example

# Environment variables and local secret files
.env
.env.*
!.env.example
!.env.*.example
secrets/
*.secret
*.secrets
*.key
*.pem
*.pfx
*.p12
credentials.json
azure-credentials.json
*azure*credentials*
*.credentials
*.credential
*.token
*.apikey
*.api-key
*.access-token

# Generated test and coverage output
TestResults/
coverage/
coverage.*
*.coverage

# Local Secret Configuration files
*.env
appsettings.Development.json
